# ── MongoDB ──────────────────────────────────────────────────────────────
# Connection string for your MongoDB cluster (Atlas or self-hosted).
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventsaaga?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB_NAME=eventsaaga

# ── Authentication (NextAuth) ────────────────────────────────────────────
# Required. Generate a strong random secret, e.g.: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_32_char_secret_here
# The canonical URL of your deployed site (used for callback URLs & reset links)
NEXTAUTH_URL=https://eventsaaga.com

# Google OAuth (OPTIONAL — customer "Continue with Google" login).
# Leave blank to disable; the Google button simply won't be wired without these.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Super Admin Seed (used only by `npm run seed:admin`, run once) ──────
# There is no public admin signup route — this is the only way to create
# the single SUPER_ADMIN account. See scripts/seed-admin.js for usage.
# ADMIN_EMAIL=you@eventsaaga.com
# ADMIN_PASSWORD=set-a-strong-password-then-remove-this-line
# ADMIN_NAME="Super Admin"

# ── Email (SMTP via Nodemailer) ─────────────────────────────────────────
# Works with any SMTP provider (Gmail, SendGrid, Mailgun, Amazon SES, Zoho, etc.)
# Also used for password-reset emails and booking confirmation notifications.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# Address bookings are sent FROM (must be authorized on your SMTP provider)
EMAIL_FROM="EventSaaga <bookings@eventsaaga.com>"
# Address(es) new lead notifications are sent TO (comma-separated for multiple)
ADMIN_NOTIFICATION_EMAIL=admin@eventsaaga.com

# ── SMS / OTP (OPTIONAL — not yet wired) ─────────────────────────────────
# No SMS provider is integrated yet. Phone-based OTP login requires choosing
# a provider (e.g. Twilio, MSG91, Firebase Auth) and is not included here —
# see the final response notes for what integrating one would require.
# SMS_PROVIDER_API_KEY=

# ── WhatsApp / Contact (used across booking CTAs) ───────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_CONTACT_PHONE=9876543210

# ── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://eventsaaga.com
